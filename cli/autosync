<?php

/**
 * Remote/local domain list sources to sync into local domains.txt
 */
$domainSources = array(
    'https://optolan.net.ua/1984tech/domains.txt',
    'https://raw.githubusercontent.com/zlobar/ua_dnsblock/refs/heads/main/domains.txt',
);

include('api.1984tech.php');
$tech = new OrwellWorld();

//need at least 1 command line argument
if ($argc >= 2) {
    $allowedOptions = array(
        '--run' => 'sync all sources from $domainSources and append new valid unique domains to domains.txt',
        '--preview' => 'same as --run but only show what would be appended (dry-run)',
        '--list' => 'list configured domain sources',
        '--help' => 'show small help'
    );

    $option = $argv[1];
    if (isset($allowedOptions[$option])) {
        switch ($option) {
            case '--run':
                print($tech->autoSync($domainSources, false));
                break;
            case '--preview':
                print($tech->autoSync($domainSources, true));
                break;
            case '--list':
                print('Configured domain sources:' . PHP_EOL);
                if (!empty($domainSources)) {
                    foreach ($domainSources as $io => $eachSource) {
                        print(($io + 1) . '. ' . $eachSource . PHP_EOL);
                    }
                } else {
                    print('(empty)' . PHP_EOL);
                }
                break;
            case '--help':
                print('Usage: php cli/autosync --option' . PHP_EOL);
                print('Available options:' . PHP_EOL);
                if (!empty($allowedOptions)) {
                    foreach ($allowedOptions as $optionName => $optionDesc) {
                        print($optionName . ' - ' . $optionDesc . PHP_EOL);
                    }
                }
                break;
        }
    } else {
        print('Unknown command line option: ' . $option . PHP_EOL);
    }
} else {
    //option requirement notification
    print('At least one option required.' . PHP_EOL);
    print('Usage: php cli/autosync --option' . PHP_EOL);
    print('For example: php cli/autosync --help' . PHP_EOL);
}
